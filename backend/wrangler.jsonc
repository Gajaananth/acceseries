{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acceseries-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["5 0 * * *"]
  },
  "vars": {
    "APP_NAME": "Acceseries",
    "APP_ENV": "production",
    "SUPABASE_URL": "https://nojijyfwgbeqlevqcgle.supabase.co",
    "ALLOWED_ORIGINS": "https://acceseries.vercel.app"
  }
}
